{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":configMigration",
    ":maintainLockFilesWeekly",
    ":timezone(Asia/Tokyo)"
  ],
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "extends": [
        "packages:linters"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "linters"
    },
    {
      "extends": [
        "packages:test"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "test packages"
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "elixir"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>otp-\\d+)$"
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "elixir",
        "erlang"
      ],
      "groupName": "Elixir and Erlang/OTP",
      "minimumGroupSize": 2
    }
  ]
}
