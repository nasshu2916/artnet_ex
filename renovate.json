{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":configMigration",
    ":maintainLockFilesWeekly",
    ":timezone(Asia/Tokyo)"
  ],
  "dependencyDashboardTitle": "Dependency Dashboard",
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Extract Elixir's otp suffix as a synthetic Erlang/OTP dependency.",
      "managerFilePatterns": [
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "elixir\\s*=\\s*\"\\d+\\.\\d+\\.\\d+-otp-(?<currentValue>\\d+)\""
      ],
      "depNameTemplate": "erlang-otp",
      "packageNameTemplate": "erlang/otp",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^OTP-(?<version>\\d+)\\.",
      "versioningTemplate": "regex:^(?<major>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update the latest Elixir version in the GitHub Actions runtime matrix.",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/test\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: elixir-runtime\\s*\\n\\s*- elixir: '(?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "depNameTemplate": "elixir",
      "packageNameTemplate": "elixir-lang/elixir",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+\\.\\d+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the latest Erlang/OTP version in the GitHub Actions runtime matrix.",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/test\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: erlang-otp-runtime\\s*\\n\\s*otp: '(?<currentValue>\\d+)'"
      ],
      "depNameTemplate": "erlang-otp",
      "packageNameTemplate": "erlang/otp",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^OTP-(?<version>\\d+)\\.",
      "versioningTemplate": "regex:^(?<major>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group non-major linter updates together.",
      "extends": [
        "packages:linters"
      ],
      "groupName": "linters",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "Group non-major test dependency updates together.",
      "extends": [
        "packages:test"
      ],
      "groupName": "test packages",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "Parse and group Elixir mise versions with their otp suffix.",
      "groupName": "Elixir/Erlang/OTP runtime",
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "elixir"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>otp-\\d+)$"
    },
    {
      "description": "Group mise runtime updates with the latest GitHub Actions runtime matrix updates.",
      "groupName": "Elixir/Erlang/OTP runtime",
      "matchManagers": [
        "mise",
        "custom.regex"
      ],
      "matchPackageNames": [
        "elixir",
        "erlang",
        "erlang/otp"
      ],
      "minimumGroupSize": 2
    },
    {
      "description": "Group non-major development-only Mix dependency updates.",
      "groupName": "dev dependencies",
      "matchDepTypes": [
        "dev"
      ],
      "matchManagers": [
        "mix"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    }
  ]
}
